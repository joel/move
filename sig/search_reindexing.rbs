# Shim for Search::Reindexing (packs/search/app/actions/search/reindexing.rb) —
# the one pack-owned mixin the root actions layer includes (Boxes::Update).
# The pack is outside the Steep check scope, so its constant is invisible to the
# RBS environment; declare just the mixin surface the actions layer calls.
# Delete this file when packs/search gets its own Steep target (the pack's
# inline annotations will then own the truth).
module Search
  module Reindexing
    def reindex_items: (untyped item_ids, ?indexing_run: untyped) -> void
  end
end
