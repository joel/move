# Gaps in the community gem signatures (gem_rbs_collection) that real call
# sites in the checked scope hit. Each entry is a Rails API that EXISTS at
# runtime but is missing from the (Rails-7.0-era) community sigs — reopened
# additively here. Re-audit when the collection's rails sigs catch up.

# Rails 8.1 structured events (`Rails.event.notify` — AGENTS.md §1 rule 4's
# emission mechanism, used by every action's emit_event) and the error
# reporter (`Rails.error.report` — Sentry-visible handled-error channel, used
# by RecognitionRuns::Process's isolated announcement, #649). Untyped on
# purpose — the reporters' surfaces aren't worth modelling until community
# sigs catch up.
module Rails
  def self.event: () -> untyped

  def self.error: () -> untyped
end

# action_policy has no community RBS. The mixin the controllers include; its
# method surface is declared as checked call sites demand.
module ActionPolicy
  module Controller
    def authorize!: (?untyped record, **untyped) -> untyped

    def allowed_to?: (Symbol rule, ?untyped record, **untyped) -> bool

    def authorized_scope: (untyped scope, **untyped) -> untyped
  end
end

# Route helpers (rbs_rails-generated interface, sig/rbs_rails/path_helpers.rbs,
# regenerated under RAILS_ENV=test so the route set is deterministic) mixed
# into the controllers so `move_box_path(...)` calls type-check — a renamed
# route becomes a NoMethod error at the call site. Plus the controller-side
# helpers the 7.0-era actionpack sigs / no-RBS gems don't declare:
# turbo-rails' turbo_stream builder, rodauth-rails' rodauth accessor, and the
# Rails 8 rate_limit macro.
class ApplicationController
  include ::_RbsRailsPathHelpers

  def turbo_stream: () -> untyped

  def rodauth: (?Symbol name) -> untyped

  def self.rate_limit: (**untyped) -> void

  # The offline renderer (`ApplicationController.render(view, layout: false)`)
  # used by the Turbo Stream broadcasting modules; missing from the 7.0 sigs.
  def self.render: (*untyped, **untyped) -> untyped

  # action_policy's controller-level macro (authorize :user, through: ...).
  def self.authorize: (*untyped, **untyped) -> void

  # importmap-rails' freshness macro.
  def self.stale_when_importmap_changes: () -> void
end

# Gem class-macros used in model class bodies (known singleton types now that
# model files are checked). Logidze and neighbor have no community RBS;
# discard_cascade_to is this app's own Discardable concern macro (the concern
# files are Steepfile-ignored — see there — so its macro is declared here).
class ApplicationRecord
  def self.has_logidze: (?ignore_log_data: bool) -> void

  def self.has_neighbors: (*untyped, **untyped) -> void

  def self.discard_cascade_to: (*untyped associations) -> void
end

# The 7.0-era activestorage sigs miss the blob-delegation readers that
# has_one_attached proxies provide (Media uses both), and the ActiveRecord
# query surface on Attachment (engine models are excluded from rbs_rails
# generation — env-dependent paths — so the community sig is all Attachment
# has, and it lacks `.where`).
module ActiveStorage
  class Attachment
    def self.where: (**untyped) -> untyped
  end

  class Attached
    class One
      def content_type: () -> untyped

      def blob: () -> untyped
    end
  end
end
