# Concern modules are deliberately UNCHECKED (see the Steepfile — `included do`
# DSL bodies and controller/AR API called on module-self are unmodellable), so
# they aren't inline-declared anywhere. These declarations make the includes
# resolve; each concern's surface is declared only as checked call sites
# demand (before_action symbol references are dynamic and need nothing).

# ── Model concerns (packs/utility/app/models/concerns) ──
module Discardable
  RETENTION: ActiveSupport::Duration
end

module Roleable
end

# ── Controller concerns (app/controllers/concerns) ──
module MoveSettings
  def settings_view: (?revealed_token: untyped) -> untyped
end

module LabelPrintForm
  def label_print_form: (?error: untyped, ?confirm: untyped) -> untyped

  def param_int: (untyped key) -> Integer?
end

module McpAuthentication
  def current_tenant: () -> untyped
end

module TurboStreamable
  def respond_with_streams: (untyped streams, redirect: untyped, ?toast: untyped, ?status: Symbol) -> untyped
end

module FindListPinnable
  def pinnable?: () -> bool

  def pinned_item_ids: () -> untyped
end

# The contents grid's standalone cards (#889).
module BoxGridItems
  def standalone_grid_items: () -> Array[untyped]

  def preload_item_tiles: (Array[untyped] items) -> void
end

# ReviewsController#move_photo responses (#874).
module ReviewPhotoMoveResponses
  def photo_moved_response: (untyped target, completed_source: untyped) -> untyped

  def photo_move_lost_race: () -> untyped

  def photo_gone_path: () -> String

  def move_photo_error: (untyped reason) -> String
end

# The per-photo review item list + its stream (ReviewsController; #881).
module ReviewItemListing
  def photo_items: (untyped media) -> untyped

  def conflict_suggestions: () -> untyped

  def queue_mode?: () -> bool

  def queue_query: () -> Hash[Symbol, String]

  def review_list_stream: (Array[untyped] items, ?highlight_id: untyped) -> untyped
end

# ReviewsController#dismiss_conflict / #keep_both_conflict responses (#881).
module ReviewConflictResponses
  def resolve_conflict: (Symbol outcome) -> Dry::Monads::Result[untyped, untyped]

  def conflict_resolved_response: (String message, untyped item, ?highlight_id: untyped) -> untyped

  def conflict_refused_response: (untyped reason) -> untyped

  def conflict_refusal_message: (untyped reason) -> String

  def conflict_photo_path: () -> String
end

# ── View concerns (app/views/layouts) ──
module Views
  module Layouts
    module ChromeHead
      def render_head: () -> untyped

      def render_theme_boot_script: () -> untyped

      def app_name: () -> String
    end
  end
end
