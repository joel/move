# Concern modules are deliberately UNCHECKED (see the Steepfile — `included do`
# DSL bodies and controller/AR API called on module-self are unmodellable), so
# they aren't inline-declared anywhere. These declarations make the includes
# resolve; each concern's surface is declared only as checked call sites
# demand (before_action symbol references are dynamic and need nothing).

# ── Model concerns (packs/utility/app/models/concerns) ──
module Discardable
  RETENTION: ActiveSupport::Duration
end

module Roleable
end

# ── Controller concerns (app/controllers/concerns) ──
module MoveSettings
  def settings_view: (?revealed_token: untyped) -> untyped
end

module LabelPrintForm
  def label_print_form: (?error: untyped, ?confirm: untyped) -> untyped

  def param_int: (untyped key) -> Integer?
end

module McpAuthentication
  def current_tenant: () -> untyped
end

module TurboStreamable
  def respond_with_streams: (untyped streams, redirect: untyped, ?toast: untyped, ?status: Symbol) -> untyped
end

module FindListPinnable
  def pinnable?: () -> bool

  def pinned_item_ids: () -> untyped
end

# ── View concerns (app/views/layouts) ──
module Views
  module Layouts
    module ChromeHead
      def render_head: () -> untyped

      def render_theme_boot_script: () -> untyped

      def app_name: () -> String
    end
  end
end
