# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# In CI the secrets are already present as environment variables (Doppler's
# GitHub integration syncs them into GitHub Actions secrets, which the Deploy
# workflow exports). Locally they are not set, so fall back to the Doppler CLI.
# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item KAMAL_REGISTRY_PASSWORD POSTGRES_PASSWORD)
if [ -z "$KAMAL_REGISTRY_PASSWORD" ]; then
  SECRETS=$(kamal secrets fetch --adapter doppler --from move/prd KAMAL_REGISTRY_PASSWORD POSTGRES_PASSWORD NOTIF_MAIL_USERNAME NOTIF_MAIL_PASSWORD)
  KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
  POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD ${SECRETS})
  NOTIF_MAIL_USERNAME=$(kamal secrets extract NOTIF_MAIL_USERNAME ${SECRETS})
  NOTIF_MAIL_PASSWORD=$(kamal secrets extract NOTIF_MAIL_PASSWORD ${SECRETS})
fi

# Locally read the master key from the (git-ignored) file; in CI it is provided
# as an environment variable. Never check config/master.key into git!
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:-$(cat config/master.key)}
