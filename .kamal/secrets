# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
#
# kamal parses this file with dotenv (not a shell), so each secret is resolved
# independently on its own line. Resolution is gated on KAMAL_SECRETS_FROM_ENV:
#   - CI (the Deploy workflow sets the flag + exports the secrets Doppler's GitHub
#     integration syncs into GitHub Actions): read the value from the environment.
#   - Local (flag unset): ALWAYS read from Doppler — never the ambient shell/.env.
# Deliberately NOT env-first locally: Kamal auto-loads .env and inherits the shell,
# so a stale exported value would otherwise shadow Doppler (the source of truth)
# and quietly deploy the wrong secret. Local deploys therefore require Doppler auth.

KAMAL_REGISTRY_PASSWORD=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$KAMAL_REGISTRY_PASSWORD" || doppler secrets get KAMAL_REGISTRY_PASSWORD --plain --project move --config prd)
POSTGRES_PASSWORD=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$POSTGRES_PASSWORD" || doppler secrets get POSTGRES_PASSWORD --plain --project move --config prd)
NOTIF_MAIL_USERNAME=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$NOTIF_MAIL_USERNAME" || doppler secrets get NOTIF_MAIL_USERNAME --plain --project move --config prd)
NOTIF_MAIL_PASSWORD=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$NOTIF_MAIL_PASSWORD" || doppler secrets get NOTIF_MAIL_PASSWORD --plain --project move --config prd)
STORAGE_ACCESS_KEY_ID=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$STORAGE_ACCESS_KEY_ID" || doppler secrets get STORAGE_ACCESS_KEY_ID --plain --project move --config prd)
STORAGE_SECRET_ACCESS_KEY=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$STORAGE_SECRET_ACCESS_KEY" || doppler secrets get STORAGE_SECRET_ACCESS_KEY --plain --project move --config prd)

# Cloudflare R2 — the production media object store (#567 / resolves #537). The
# endpoint carries the account id so it's a secret. Provision an R2 bucket
# (move-media) + an S3 API token (Object Read & Write), then:
#   doppler secrets set R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_ENDPOINT --project move --config prd
# (R2_ENDPOINT = https://<account-id>.r2.cloudflarestorage.com). REQUIRED once the
# prod service is :r2 — same "Kamal swallows substitution failures" caveat as the
# restic/backup secrets below applies; the Deploy secrets guard is the real gate.
R2_ACCESS_KEY_ID=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$R2_ACCESS_KEY_ID" || doppler secrets get R2_ACCESS_KEY_ID --plain --project move --config prd)
R2_SECRET_ACCESS_KEY=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$R2_SECRET_ACCESS_KEY" || doppler secrets get R2_SECRET_ACCESS_KEY --plain --project move --config prd)
R2_ENDPOINT=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$R2_ENDPOINT" || doppler secrets get R2_ENDPOINT --plain --project move --config prd)

# Cloudflare-edge media transform Worker HMAC secret (#572). DEDICATED — NOT
# secret_key_base/RAILS_MASTER_KEY — so it rotates independently of every other
# signed artefact and a Worker-side leak can't forge sessions/cookies. The SAME
# value is provisioned to the Worker with `wrangler secret put MEDIA_TRANSFORM_SECRET`:
#   openssl rand -hex 32   # generate once, set on BOTH sides
#   doppler secrets set MEDIA_TRANSFORM_SECRET --project move --config prd
# REQUIRED once MEDIA_TRANSFORM_HOST is set in config/deploy.yml (else prod mints
# unsigned-secret URLs and TransformUrl raises). See workers/media-transform/README.md.
MEDIA_TRANSFORM_SECRET=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$MEDIA_TRANSFORM_SECRET" || doppler secrets get MEDIA_TRANSFORM_SECRET --plain --project move --config prd)

# Encrypted DB backups (#536): the restic repository URL + encryption key and
# the R2 token pair for the `backup` accessory (restic's S3 backend requires the
# exact AWS_* names). Semantics, provisioning and runbooks: doc/project/backups.md.
# REQUIRED (no --no-exit-on-missing-secret) — but note Kamal swallows command-
# substitution failures here, so the flag alone does NOT stop an accessory boot
# with an empty value; the real gates are the Deploy workflow's secrets guard
# (CI) and `kamal-backup validate` before any accessory boot/reboot (local).
RESTIC_REPOSITORY=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$RESTIC_REPOSITORY" || doppler secrets get RESTIC_REPOSITORY --plain --project move --config prd)
RESTIC_PASSWORD=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$RESTIC_PASSWORD" || doppler secrets get RESTIC_PASSWORD --plain --project move --config prd)
AWS_ACCESS_KEY_ID=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$AWS_ACCESS_KEY_ID" || doppler secrets get AWS_ACCESS_KEY_ID --plain --project move --config prd)
AWS_SECRET_ACCESS_KEY=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$AWS_SECRET_ACCESS_KEY" || doppler secrets get AWS_SECRET_ACCESS_KEY --plain --project move --config prd)

# Google social sign-in (OmniAuth redirect + One Tap). Optional: resolves to
# empty until provisioned in Doppler move/prd, and an empty value just keeps the
# Google button/One Tap hidden (gated on GOOGLE_CLIENT_ID.present?).
# --no-exit-on-missing-secret: these are OPTIONAL, so a local deploy before they
# exist in Doppler must yield an empty value, not abort (the CLI exits on a
# missing secret by default). The required secrets above intentionally omit the
# flag so a broken sync fails loudly.
GOOGLE_CLIENT_ID=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$GOOGLE_CLIENT_ID" || doppler secrets get GOOGLE_CLIENT_ID --plain --no-exit-on-missing-secret --project move --config prd)
GOOGLE_CLIENT_SECRET=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$GOOGLE_CLIENT_SECRET" || doppler secrets get GOOGLE_CLIENT_SECRET --plain --no-exit-on-missing-secret --project move --config prd)

# Sentry error monitoring (#528). OPTIONAL like the Google pair above: an empty
# value just leaves the SDK disabled (config/initializers/sentry.rb gates on DSN
# presence), so a deploy before the secret exists in Doppler must not abort.
SENTRY_DSN=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$SENTRY_DSN" || doppler secrets get SENTRY_DSN --plain --no-exit-on-missing-secret --project move --config prd)

# No OPENAI_API_KEY here any more: D8 search embeddings (#232) and image
# recognition (#185) are both per-Move bring-your-own-key, keyed by each Move's
# own encrypted openai_api_key, so the deploy injects no shared AI key (and it is
# no longer in Doppler). Its only consumer is the Release Bug Scan workflow, which
# uses a distinctly named CI-only GitHub Actions repo secret (CODEX_OPENAI_API_KEY).

# In CI the master key is provided as an env var; locally read the git-ignored file.
RAILS_MASTER_KEY=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$RAILS_MASTER_KEY" || cat config/master.key)
