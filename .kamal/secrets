# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
#
# kamal parses this file with dotenv (not a shell), so each secret is resolved
# independently on its own line: use the value already in the environment — e.g.
# the Deploy workflow exports the secrets Doppler's GitHub integration syncs into
# GitHub Actions — otherwise fall back to the Doppler CLI for local deploys. The
# subshell expands $VAR from the inherited environment (values with special
# characters survive intact), and resolving per-secret means a partially
# populated local shell still fetches only what is missing.

KAMAL_REGISTRY_PASSWORD=$([ -n "$KAMAL_REGISTRY_PASSWORD" ] && printf %s "$KAMAL_REGISTRY_PASSWORD" || doppler secrets get KAMAL_REGISTRY_PASSWORD --plain --project move --config prd)
POSTGRES_PASSWORD=$([ -n "$POSTGRES_PASSWORD" ] && printf %s "$POSTGRES_PASSWORD" || doppler secrets get POSTGRES_PASSWORD --plain --project move --config prd)
NOTIF_MAIL_USERNAME=$([ -n "$NOTIF_MAIL_USERNAME" ] && printf %s "$NOTIF_MAIL_USERNAME" || doppler secrets get NOTIF_MAIL_USERNAME --plain --project move --config prd)
NOTIF_MAIL_PASSWORD=$([ -n "$NOTIF_MAIL_PASSWORD" ] && printf %s "$NOTIF_MAIL_PASSWORD" || doppler secrets get NOTIF_MAIL_PASSWORD --plain --project move --config prd)
STORAGE_ACCESS_KEY_ID=$([ -n "$STORAGE_ACCESS_KEY_ID" ] && printf %s "$STORAGE_ACCESS_KEY_ID" || doppler secrets get STORAGE_ACCESS_KEY_ID --plain --project move --config prd)
STORAGE_SECRET_ACCESS_KEY=$([ -n "$STORAGE_SECRET_ACCESS_KEY" ] && printf %s "$STORAGE_SECRET_ACCESS_KEY" || doppler secrets get STORAGE_SECRET_ACCESS_KEY --plain --project move --config prd)

# OpenAI key for the recognition + embedding adapters (RECOGNITION_PROVIDER /
# EMBEDDING_PROVIDER = openai in deploy.yml). Must exist in Doppler move/prd
# before those providers are flipped on, or every run fails — see
# doc/project/ai-providers.md.
OPENAI_API_KEY=$([ -n "$OPENAI_API_KEY" ] && printf %s "$OPENAI_API_KEY" || doppler secrets get OPENAI_API_KEY --plain --project move --config prd)

# Google Gemini key for the recognition adapter (RECOGNITION_PROVIDER=gemini).
# Optional today — prod still runs openai — but must exist in Doppler move/prd
# before anyone flips RECOGNITION_PROVIDER to gemini, or every run fails.
GEMINI_API_KEY=$([ -n "$GEMINI_API_KEY" ] && printf %s "$GEMINI_API_KEY" || doppler secrets get GEMINI_API_KEY --plain --project move --config prd)

# Locally read the (git-ignored) master key file; in CI it is provided as an env var.
RAILS_MASTER_KEY=$([ -n "$RAILS_MASTER_KEY" ] && printf %s "$RAILS_MASTER_KEY" || cat config/master.key)
