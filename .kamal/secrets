# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
#
# kamal parses this file with dotenv (not a shell), so each secret is resolved
# independently on its own line. Resolution is gated on KAMAL_SECRETS_FROM_ENV:
#   - CI (the Deploy workflow sets the flag + exports the secrets Doppler's GitHub
#     integration syncs into GitHub Actions): read the value from the environment.
#   - Local (flag unset): ALWAYS read from Doppler — never the ambient shell/.env.
# Deliberately NOT env-first locally: Kamal auto-loads .env and inherits the shell,
# so a stale exported value would otherwise shadow Doppler (the source of truth)
# and quietly deploy the wrong secret. Local deploys therefore require Doppler auth.

KAMAL_REGISTRY_PASSWORD=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$KAMAL_REGISTRY_PASSWORD" || doppler secrets get KAMAL_REGISTRY_PASSWORD --plain --project move --config prd)
POSTGRES_PASSWORD=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$POSTGRES_PASSWORD" || doppler secrets get POSTGRES_PASSWORD --plain --project move --config prd)
NOTIF_MAIL_USERNAME=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$NOTIF_MAIL_USERNAME" || doppler secrets get NOTIF_MAIL_USERNAME --plain --project move --config prd)
NOTIF_MAIL_PASSWORD=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$NOTIF_MAIL_PASSWORD" || doppler secrets get NOTIF_MAIL_PASSWORD --plain --project move --config prd)
STORAGE_ACCESS_KEY_ID=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$STORAGE_ACCESS_KEY_ID" || doppler secrets get STORAGE_ACCESS_KEY_ID --plain --project move --config prd)
STORAGE_SECRET_ACCESS_KEY=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$STORAGE_SECRET_ACCESS_KEY" || doppler secrets get STORAGE_SECRET_ACCESS_KEY --plain --project move --config prd)

# Google social sign-in (OmniAuth redirect + One Tap). Optional: resolves to
# empty until provisioned in Doppler move/prd, and an empty value just keeps the
# Google button/One Tap hidden (gated on GOOGLE_CLIENT_ID.present?).
GOOGLE_CLIENT_ID=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$GOOGLE_CLIENT_ID" || doppler secrets get GOOGLE_CLIENT_ID --plain --project move --config prd)
GOOGLE_CLIENT_SECRET=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$GOOGLE_CLIENT_SECRET" || doppler secrets get GOOGLE_CLIENT_SECRET --plain --project move --config prd)

# No OPENAI_API_KEY here any more: D8 search embeddings (#232) and image
# recognition (#185) are both per-Move bring-your-own-key, keyed by each Move's
# own encrypted openai_api_key, so the deploy injects no shared AI key (and it is
# no longer in Doppler). Its only consumer is the Release Bug Scan workflow, which
# uses a distinctly named CI-only GitHub Actions repo secret (CODEX_OPENAI_API_KEY).

# In CI the master key is provided as an env var; locally read the git-ignored file.
RAILS_MASTER_KEY=$([ -n "$KAMAL_SECRETS_FROM_ENV" ] && printf %s "$RAILS_MASTER_KEY" || cat config/master.key)
