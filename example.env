# These environment variables are needed to run the app locally.
# Copy these into a file named .env.development to have them loaded automatically.

# Dev Active Storage runs against the local SeaweedFS S3 (config.active_storage
# .service = :seaweedfs). The app container reaches the gateway by its container
# name on the shared Docker network — NOT storage.move-easy.docker, which
# Traefik now routes to the SeaweedFS Web UI (:8888). The bucket/region/keys fall
# back to dev-safe defaults in config/storage.yml.
STORAGE_ENDPOINT=http://seaweedfs:8333

# AI image recognition. Defaults to the network-free `fake` provider. To exercise
# a real vendor locally, set RECOGNITION_PROVIDER + the matching key. Each model
# default is overridable via *_RECOGNITION_MODEL.
# RECOGNITION_PROVIDER=openai          # openai | anthropic | gemini | fake
# OPENAI_API_KEY=sk-...
# OPENAI_RECOGNITION_MODEL=gpt-5-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_RECOGNITION_MODEL=claude-haiku-4-5-20251001
# GEMINI_API_KEY=...
# GEMINI_RECOGNITION_MODEL=gemini-2.5-flash
